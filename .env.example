# DAT250 local lab configuration
# Do not use these values for real systems or public deployments.

APP_NAME=DAT250 SecureApp
APP_ENV=lab
POSTGRES_USER=dat250
POSTGRES_PASSWORD=dat250
POSTGRES_DB=dat250
DATABASE_URL=postgresql://dat250:dat250@db:5432/dat250
SESSION_SECRET=dev-session-secret-12345
MAILHOG_HOST=mailhog
MAILHOG_PORT=1025
BASE_URL=http://localhost:18181

# Session / authentication hardening (Assignment 2)
SESSION_MAX_AGE_SECONDS=28800
RESET_TOKEN_TTL_SECONDS=1800
# Set to true when the app is served over HTTPS
COOKIE_SECURE=false
